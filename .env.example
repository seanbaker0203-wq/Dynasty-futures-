# Copy to .env (never commit .env).

# Optional: Gemini key for the AI trade-ideas API (/api/trade/ai-suggest).
GEMINI_API_KEY=""

# Optional: override the Gemini model.
# GEMINI_MODEL="gemini-3.8-flash"

# Port to listen on (Render/Railway set this automatically).
# PORT=3000

# Supabase (accounts, private notes, value history). URL and publishable/anon key are public by design.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_ANON_KEY="sb_publishable_..."
# Server only, never in the browser or in git: SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
